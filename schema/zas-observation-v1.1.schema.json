{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZAS suspicion-only observation 4.3.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "agent_id", "service_generation", "snapshot_seq", "count_scope", "tools", "reasoning", "coverage"],
  "properties": {
    "schema": { "const": "zas-observation/1.1" },
    "agent_id": { "type": "string", "minLength": 1 },
    "service_generation": { "type": "string", "minLength": 1 },
    "snapshot_seq": { "type": "integer", "minimum": 0 },
    "count_scope": { "const": "agent_lifetime" },
    "tools": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool_name", "call_count", "recent_calls"],
        "properties": {
          "tool_name": { "type": "string", "minLength": 1 },
          "call_count": { "type": "integer", "minimum": 1 },
          "recent_calls": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["seq", "tool_call_id", "arguments", "arguments_truncated", "redacted_fields"],
              "properties": {
                "seq": { "type": "integer", "minimum": 1 },
                "tool_call_id": { "type": "string", "minLength": 1 },
                "arguments": { "type": "object" },
                "arguments_truncated": { "type": "boolean" },
                "redacted_fields": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    },
    "reasoning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "char_count", "truncated", "source"],
      "properties": {
        "text": { "type": "string", "maxLength": 200 },
        "char_count": { "type": "integer", "minimum": 0, "maximum": 200 },
        "truncated": { "type": "boolean" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "runtime_version", "event_type", "delta_pointer"],
          "properties": {
            "status": { "const": "VERIFIED_RUNTIME_PUBLIC" },
            "runtime_version": { "type": "string", "minLength": 1 },
            "event_type": { "type": "string", "minLength": 1 },
            "delta_pointer": { "type": "string", "pattern": "^/" }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_history_complete", "reasoning_complete", "dropped_events"],
      "properties": {
        "tool_history_complete": { "type": "boolean" },
        "reasoning_complete": { "type": "boolean" },
        "dropped_events": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
