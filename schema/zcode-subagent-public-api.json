{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zcode-as-subagent.invalid/schema/public-api.json",
  "title": "zcode-as-subagent MCP public API",
  "description": "The intentionally small zcode_subagent_* wire catalog.",
  "type": "object",
  "required": ["tools"],
  "properties": {
    "tools": {
      "type": "array",
      "const": ["zcode_subagent_cancel", "zcode_subagent_close", "zcode_subagent_list", "zcode_subagent_observe", "zcode_subagent_poll", "zcode_subagent_respond", "zcode_subagent_result", "zcode_subagent_send", "zcode_subagent_spawn", "zcode_subagent_status"]
    },
    "permission_mode": { "enum": ["build", "edit", "plan", "yolo"], "default": "build" },
    "spawn": {
      "type": "object",
      "required": ["repository", "prompt"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "permission_mode": { "$ref": "#/properties/permission_mode" },
        "prompt": { "type": "string", "minLength": 1 },
        "write_manifest": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "allOf": [
        { "if": { "required": ["permission_mode"], "properties": { "permission_mode": { "const": "plan" } } },
          "then": { "properties": { "write_manifest": { "maxItems": 0 } } } }
      ],
      "additionalProperties": false
    },
    "list": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "phase": { "type": ["string", "null"], "default": null },
        "outcome": { "type": ["string", "null"], "default": null },
        "cursor": { "type": ["string", "null"], "default": null },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 100 }
      },
      "additionalProperties": false
    },
    "poll": {
      "type": "object",
      "required": ["agent_id"],
      "properties": {
        "agent_id": { "type": "string", "minLength": 1 },
        "after_revision": { "type": "integer", "minimum": 0, "default": 0 },
        "timeout_ms": { "type": "integer", "minimum": 0, "maximum": 5000, "default": 0 }
      },
      "additionalProperties": false
    },
    "observe": {
      "type": "object",
      "required": ["agent_id"],
      "properties": {
        "agent_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": ["agent_id"],
      "properties": {
        "agent_id": { "type": "string", "minLength": 1 },
        "offset": { "type": "integer", "minimum": 0, "default": 0 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 81920, "default": 81920 }
      },
      "additionalProperties": false
    },
    "result_projection": {
      "type": "object",
      "required": ["outcome", "final_text", "partial", "offset", "total_bytes", "next_offset", "complete"],
      "properties": {
        "outcome": { "enum": ["COMPLETED", "FAILED", "CANCELLED", "TIMED_OUT", "RUNTIME_LOST", "RESULT_INVALID"] },
        "final_text": { "type": "string" },
        "partial": { "type": "boolean" },
        "offset": { "type": "integer", "minimum": 0 },
        "total_bytes": { "type": "integer", "minimum": 0 },
        "next_offset": { "type": ["integer", "null"], "minimum": 0 },
        "complete": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "error_projection": {
      "type": "object",
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 },
            "component": { "type": "string", "minLength": 1 },
            "operation": { "type": "string", "minLength": 1 },
            "request_id": { "type": "string", "minLength": 1 },
            "agent_id": { "type": "string", "minLength": 1 },
            "cleanup": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zcode_subagent_status": { "input": [], "output": ["api_surface", "protocol_version", "service_generation", "components", "capabilities", "identity"] },
        "zcode_subagent_spawn": { "input": ["repository", "permission_mode", "prompt", "write_manifest"], "output": ["agent_id", "submission_disposition", "phase"], "idempotent": false },
        "zcode_subagent_poll": { "input": ["agent_id", "after_revision", "timeout_ms"], "output": ["task", "revision", "next_revision", "pending_requests", "result_available", "activity", "latest_progress", "result", "instruction", "timed_out"] },
        "zcode_subagent_observe": { "input": ["agent_id"], "output": ["schema", "agent_id", "service_generation", "snapshot_seq", "count_scope", "tools", "reasoning", "coverage"], "idempotent": true },
        "zcode_subagent_list": { "input": ["repository", "phase", "outcome", "cursor", "limit"], "output": ["tasks", "next_cursor"] },
        "zcode_subagent_send": { "input": ["agent_id", "message_id", "content"], "output": ["disposition"] },
        "zcode_subagent_respond": { "input": ["agent_id", "request_id", "decision", "reason"], "output": ["disposition", "requested_decision", "effective_decision", "policy_overrode", "policy_reason_code"] },
        "zcode_subagent_cancel": { "input": ["agent_id"], "output": ["task"] },
        "zcode_subagent_result": { "input": ["agent_id", "offset", "limit"], "output": ["task", "result"] },
        "zcode_subagent_close": { "input": ["agent_id"], "output": ["task"] }
      }
    }
  },
  "additionalProperties": false
}
